---
import LogoSymbol from "./logo-symbol.astro";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
  { href: "/om", label: "Om oss" },
  { href: "/arbeid", label: "Arbeider" },
  { href: "/tjenester", label: "Våre tjenester" },
  { href: "/artikler", label: "Artikler" },
  { href: "/kontakt", label: "Kontakt oss" },
];
---

<header>
  <div
    class="bar"
    x-data="{
      navOpen: false,
      compact: window.matchMedia('(max-width: 820px)').matches,
    }"
    x-init="
      const mq = window.matchMedia('(max-width: 820px)');
      const sync = () => { compact = mq.matches; if (!compact) navOpen = false };
      mq.addEventListener('change', sync);
    "
    @keydown.escape="navOpen && (navOpen = false, $refs.menuToggle?.focus())"
    @click.outside="navOpen = false"
  >
    <a class="logo" aria-label="Gå til forsiden" href="/">
      <LogoSymbol />
    </a>
    <nav
      id="hovedmeny"
      aria-label="Hovedmeny"
      :data-open="navOpen"
      :inert="compact && !navOpen"
    >
      {
        links.map(link => (
          <a
            href={link.href}
            aria-current={
              currentPath === link.href ||
              currentPath.startsWith(`${link.href}/`)
                ? "page"
                : undefined
            }
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <button
      class="menu-toggle"
      x-ref="menuToggle"
      hidden
      x-init="$el.removeAttribute('hidden')"
      aria-label="Meny"
      aria-controls="hovedmeny"
      aria-expanded="false"
      :aria-expanded="navOpen.toString()"
      @click="navOpen = !navOpen"
    >
      <svg
        width="16"
        height="12"
        viewBox="0 0 16 12"
        fill="none"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
      >
        <rect y="0" width="16" height="1.5" fill="currentColor"></rect>
        <rect y="5.25" width="16" height="1.5" fill="currentColor"></rect>
        <rect y="10.5" width="16" height="1.5" fill="currentColor"></rect>
      </svg>
    </button>
  </div>
</header>

<style>
  header {
    --nav-text-muted: color-mix(in srgb, currentColor 60%, transparent);
    --nav-radius: 8px;
    --nav-gap: 1.875rem;
    /* Only the mobile panel still needs a surface of its own. */
    --panel-bg: var(--color-app-bg);

    width: var(--container-width);
    margin-inline: auto;
    padding-block: 1.25rem 2rem;
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--nav-gap);
    font-size: 0.875rem;
  }

  .logo {
    display: flex;
    align-items: center;
    padding-inline: 0.25rem;
    margin-inline: -0.25rem;
    color: inherit;
  }

  /* Sized here rather than on the symbol itself, which the footer reuses. */
  .logo :global(svg) {
    display: block;
    height: 24px;
  }

  nav {
    display: flex;
    align-items: center;
    gap: var(--nav-gap);
    margin-inline-start: 2rem;
  }

  nav a {
    --color-link: currentColor;
    --color-link-hover: var(--nav-text-muted);

    /* WCAG 2.2 target size: padding lifts the hit area past 24px, the negative
       margin keeps the visual layout where it was. */
    padding-block: 0.25rem;
    margin-block: -0.25rem;
    text-decoration: none;
    white-space: nowrap;
  }

  nav a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.4em;
  }

  .menu-toggle {
    display: none;
    margin-inline-start: auto;
    align-items: center;
    padding: 0.375rem;
    border: none;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  @media (max-width: 820px) {
    .bar {
      gap: 1rem;
    }

    .menu-toggle:not([hidden]) {
      display: inline-flex;
    }

    /* Hidden by default so a JS-less mobile visit never gets a dropdown stuck
       open under the bar. */
    nav {
      position: absolute;
      z-index: 9999;
      top: calc(100% + 0.5rem);
      inset-inline: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      margin-inline-start: 0;
      padding: 0.5rem;
      border: 1px solid var(--color-subtle-border);
      border-radius: var(--nav-radius);
      background-color: var(--panel-bg);
      box-shadow: 0 12px 32px hsl(var(--base-frostbite) 5% / 0.12);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-0.5rem);
      /* visibility can't tween, so it flips instantly on open and waits out the
         fade on close -- keeps the panel out of the tab order while hidden. */
      transition:
        opacity 0.3s cubic-bezier(0.42, 0, 0.34, 1.01),
        transform 0.3s cubic-bezier(0.42, 0, 0.34, 1.01),
        visibility 0s linear 0.3s;
    }

    nav[data-open="true"] {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }

    nav a {
      padding: 0.625rem 0.75rem;
      border-radius: var(--border-radius);
      font-size: 1rem;
    }
  }
</style>
