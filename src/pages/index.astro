---
import Layout from "@layouts/default.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import HeroImage from "../assets/people-working.jpg";
import ProjectCard from "@components/project-card.astro";
import PartnerCard from "@components/partner-card.astro";

const projects = await getCollection("project");
const partners = await getCollection("partner");
const url = Astro.site;
---

<Layout
  title="Bjerk - Vi skaper en bedre verden gjennom teknologi"
  socialMediaTitle="Vi skaper en bedre verden gjennom teknologi 🌳"
  socialMediaDescription="✨ Vi i Bjerk tror på kraften av teknologi for å forme en bedre fremtid! Bli med på reisen vår mens vi transformerer måten vi lærer, tenker, jobber og kommuniserer på. Sammen skaper vi digitale løsninger for en lysere og smartere verden"
  description="Oppdag hvordan Bjerk driver global forandring gjennom teknologi. Vi forenkler og forbedrer læring, tenkning, arbeid og kommunikasjon med skreddersydde digitale løsninger. Bli med oss i å skape en lysere fremtid."
  path="/"
  schema={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Bjerk",
    alternateName: ["Bjerk AS", "BJRK", "BK", "bjerk.io"],
    url,
  }}
>
  <main>
    <section class="hero">
      <div class="pitch">
        <h1>
          Bjerk er et teknologibyrå som skriver kode for å skape, forbedre og
          forenkle for ambisiøse bedrifter.
        </h1>
        <a href="/om" class="button">
          Kom i gang <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="services">
        <Image
          src={HeroImage}
          alt="Bilde av folk som jobber"
          class="landing-image"
        />
        <nav aria-label="Våre tjenester">
          <a href="/tjenester/integrasjoner">
            Data og integrasjoner <span aria-hidden="true">→</span>
          </a>
          <a href="/tjenester/radgivning">
            Rådgivning <span aria-hidden="true">→</span>
          </a>
          <a href="/tjenester/produktutvikling">
            Produktutvikling <span aria-hidden="true">→</span>
          </a>
          <a href="/tjenester/teknologi-og-utvikling">
            Teknologi og utvikling <span aria-hidden="true">→</span>
          </a>
          <a href="/tjenester/opplaring">
            Opplæring <span aria-hidden="true">→</span>
          </a>
        </nav>
      </div>
    </section>
    <span
      x-intersect:enter="colorScheme = 'dark'"
      x-intersect:leave="colorScheme = 'light'"
    >
      <section class="work" aria-labelledby="arbeid-intro">
        <h2 id="arbeid-intro" class="sr-only">Utvalgt arbeid</h2>
        <p>
          Vi skaper digitale produkter og løsninger som er tilpasset bedrifters
          unike behov og arbeidsprosesser.
        </p>

        <div class="projects">
          {
            projects
              .filter(project => project.data.image)
              .map(project => <ProjectCard {...project} />)
          }
        </div>
      </section>
      <section class="partners">
        <h2>Noen av de vi jobber med</h2>

        <div class="logos">
          {partners.map(partner => <PartnerCard {...partner} />)}
        </div>
      </section>
    </span>
  </main>
</Layout>

<style>
  .hero {
    margin-block-start: var(--space-section);
    margin-inline: auto;
    width: var(--container-width);
    display: flex;
    flex-direction: column;
    gap: var(--space-section);
  }

  .hero > .services {
    display: flex;
    flex-direction: column;
    gap: var(--space-block);

    .landing-image,
    nav {
      width: 100%;
    }

    nav {
      font-size: 1.25rem;
    }

    .landing-image {
      height: auto;
      aspect-ratio: 16 / 9;
      object-fit: cover;
    }

    & > nav {
      display: grid;
      gap: 0.5rem;
      flex-wrap: wrap;

      a {
        --color-link: var(--color-app-text);
      }
    }
  }

  .work {
    width: var(--container-width);
    margin-inline: auto;

    margin-block-start: var(--space-section);

    > .projects {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;
    }

    > p {
      max-width: 40ch;
      margin-block-end: var(--space-block);
      font-size: clamp(1rem, 2vw, 1.575rem);
      line-height: 1.4;
    }
  }

  .partners {
    width: var(--container-width);
    text-align: center;
    margin-inline: auto;
    margin-block: var(--space-section);

    > h2 {
      margin-block-end: var(--space-block);
      font-size: clamp(1.5rem, 3vw, 2.25rem);
    }

    > .logos {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-items: center;
      justify-content: center;

      gap: 3rem;
    }
  }

  .logos :global(> *) {
    max-height: 38px;
    max-width: 150px;
  }

  @media (max-width: 600px) {
    .partners > .logos {
      gap: 1.5rem;
    }

    .logos :global(> *) {
      max-height: 25px;
      max-width: 75px;
    }
  }

  h1 {
    font-size: clamp(2rem, 4.5vw, 4rem);
    line-height: 1.05;
    font-weight: 400;
    text-wrap: pretty;
    max-width: 28ch;
  }

  .button {
    display: inline-flex;
    align-items: center;
    margin-block-start: 2rem;
    gap: 0.5rem;
    color: inherit;
    font-size: 1.125rem;
    text-decoration-color: inherit;
    text-decoration-thickness: 0.1rem;
    text-underline-offset: 0.25rem;
  }
</style>
